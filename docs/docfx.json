{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "MavLinkSharp/MavLinkSharp.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/**.toc.yml"]
      },
      {
        "files": ["**.md", "**/toc.yml", "toc.yml"]
      }
    ],
    "resource": [
      {
        "files": ["images/**", "favicon.ico"]
      }
    ],
    "dest": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appTitle": "MavLinkSharp",
      "_appName": "MavLinkSharp",
      "_appFooter": "© 2026 TekLot. MIT License.",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "favicon.ico",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_gitContribute": {
        "repo": "https://github.com/teklot/mavlinksharp",
        "branch": "main"
      }
    },
    "fileMetadata": {},
    "template": ["default", "modern"],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false
  }
}